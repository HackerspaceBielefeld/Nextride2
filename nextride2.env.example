# Konfiguration von nextride2, siehe README.md.
# Pi: als /etc/nextride2.env (chmod 600). Lokal: als .env.local.

# Abfahrten: efa (Standard), vrr oder stadtbahnlive (experimentell).
DEPARTURE_SOURCE=efa
# Haltestellen 'id=Name;id=Name'. efa/stadtbahnlive: DHID, vrr: VRR-ID (23005614).
DEPARTURE_STATIONS=de:05711:5614=Ziegelstraße
# Optional, Standard je nach Quelle:
#DEPARTURE_ENDPOINT=https://www.westfalenfahrplan.de/nwl-efa
#LINE_COLORS_ENDPOINT=https://stadtbahn.live/api/v1/lines
#ROCKET_LAUNCH_ENDPOINT=https://fdo.rocketlaunch.live/json/launches/next/5

# Wetter (openweathermap.org). Ohne Key wird nichts abgefragt.
OPENWEATHER_API_KEY=
WEATHER_CITY=Bielefeld

# Home Assistant. Ohne URI/Token ist die Anbindung aus, leere Entities
# werden uebersprungen.
HASSIO_BASE_URI=
HASSIO_TOKEN=
HASSIO_TIMER_ENTITY=
HASSIO_TEXT_ENTITY=
HASSIO_WCBUSY_ENTITY=
HASSIO_LEISTUNG_ENTITY=
